# Copy to .env.local (git-ignored). Read on the server only: do not prefix with EXPO_PUBLIC_.
# The URL scheme selects the driver.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invitationcardapp

# DATABASE_URL=mysql://root:root@localhost:3306/invitationcardapp
# DATABASE_URL=sqlite:./data/app.db

# Point the app at one of the backends in server/ instead of its own API routes.
# Express: http://localhost:4000 · Nest: http://localhost:4001
# (On a physical device use your machine's LAN IP; on the Android emulator use 10.0.2.2.)
# EXPO_PUBLIC_API_URL=http://localhost:4000
