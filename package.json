{
  "name": "invitationcardapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@tanstack/react-query": "^5.107.1",
    "@types/jest": "30.0.0",
    "axios": "^1.21.1",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^27.2.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server:express": "npm --prefix server/express run dev",
    "server:nest": "npm --prefix server/nest run dev",
    "server:db": "docker compose -f server/docker-compose.yml up -d",
    "server:emulators": "cd server && npx firebase-tools emulators:start --only auth",
    "docker:express": "docker compose -f server/docker-compose.yml --profile express up -d --build",
    "docker:nest": "docker compose -f server/docker-compose.yml --profile nest up -d --build",
    "docker:all": "docker compose -f server/docker-compose.yml --profile all up -d --build",
    "docker:down": "docker compose -f server/docker-compose.yml --profile all down",
    "docker:logs": "docker compose -f server/docker-compose.yml --profile all logs -f",
    "prepare": "husky"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/server/"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
