# Copy to .env (git-ignored).
PORT=4001
# Comma-separated origins allowed by CORS (the Expo web dev server by default).
CORS_ORIGIN=http://localhost:8081

MONGODB_URI=mongodb://localhost:27017/invitationcardapp

# Optional. Enables response caching and shared rate limits (in-memory per process without it).
REDIS_URL=redis://localhost:6379
# Auth requests (register/login/refresh) allowed per IP per window.
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_WINDOW_SEC=60
# Number of proxies in front of the server (1 on Cloud Run or behind a load balancer).
TRUST_PROXY=0

# Firebase Admin: Project settings → Service accounts → Generate new private key.
# Either point GOOGLE_APPLICATION_CREDENTIALS at the JSON file...
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# ...or set the three fields below (keep the \n escapes in the private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Project settings → General → Web API key. Used for email/password sign-in and token refresh.
FIREBASE_WEB_API_KEY=

# Local development without a Firebase project: run the Auth emulator (see server/README.md)
# and uncomment. Any FIREBASE_PROJECT_ID / FIREBASE_WEB_API_KEY value works with the emulator.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
